# Configurações da Aplicação Assistente

# Base de Dados
DB_HOST=postgres
DB_PORT=5432
DB_NAME=assistente
DB_USER=app_writer
DB_PASS=sua_senha_segura_aqui

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Aplicação
TZ=America/Sao_Paulo
INTERNAL_API_BASE=http://api:7000
APP_SECRET=sua_chave_secreta_jwt_aqui

# OpenAI
OPENAI_API_KEY=sk-sua_chave_openai_aqui
OPENAI_MODEL=o4-mini
USE_OPENAI=true
OPENAI_TIMEOUT=60

# CORS e Segurança
CORS_ORIGINS=https://odontoapi.com,https://app.odontoapi.com
COOKIE_DOMAIN=.odontoapi.com

# Logs
LOG_FILE=logs/app.log
LOG_LEVEL=INFO
DEBUG=false