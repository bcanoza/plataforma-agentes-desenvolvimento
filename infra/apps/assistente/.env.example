# Configurações da Aplicação Assistente

# === ESSENCIAIS (OBRIGATÓRIAS) ===
DB_PASS=sua_senha_postgres_aqui
OPENAI_API_KEY=sk-sua_chave_openai_aqui
APP_SECRET=sua_chave_jwt_secreta_aqui

# === CONFIGURAÇÕES DO BANCO ===
DB_HOST=postgres
DB_PORT=5432
DB_NAME=assistente
DB_USER=app_writer

# === REDIS / CELERY ===
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# === APLICAÇÃO ===
TZ=America/Sao_Paulo
INTERNAL_API_BASE=http://api:7000
LOG_LEVEL=INFO

# === OPENAI ===
OPENAI_MODEL=o4-mini
USE_OPENAI=true
OPENAI_TIMEOUT=60

# === CORS E SEGURANÇA ===
CORS_ORIGINS=https://odontoapi.com,https://app.odontoapi.com,http://localhost:3000
COOKIE_DOMAIN=.odontoapi.com