# Configurações do Banco de Dados
DB_HOST=postgres
DB_PORT=5432
DB_NAME=assistente
DB_USER=app_writer
DB_PASS=password

# Redis e Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Timezone
TZ=America/Sao_Paulo

# API Interna
INTERNAL_API_BASE=http://api:7000
INTERNAL_API_KEY=your-secret-api-key

# JWT
JWT_ISS=nos-assistente
JWT_AUD=nos-ui
JWT_KID=nos-key-1
ACCESS_TTL_SEC=3600
REFRESH_TTL_SEC=1209600
APP_SECRET=your-app-secret-key

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=o4-mini
USE_OPENAI=true
OPENAI_TIMEOUT=60
OPENAI_BASE=

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
COOKIE_DOMAIN=.odontoapi.com

# Logging
LOG_FILE=logs/app.log
LOG_LEVEL=INFO
DEBUG=true