{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ModuleManifest",
  "type": "object",
  "required": [
    "id",
    "name",
    "kind",
    "version",
    "order",
    "buttons"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "system",
        "admin",
        "optional"
      ]
    },
    "version": {
      "type": "string"
    },
    "order": {
      "type": "integer"
    },
    "buttons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "route"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "route": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "order": {
            "type": "integer"
          }
        }
      }
    },
    "apis": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "baseUrl",
          "auth"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "baseUrl": {
            "type": "string"
          },
          "auth": {
            "type": "string",
            "enum": [
              "core",
              "none",
              "custom"
            ]
          },
          "allowedPaths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "timeoutMs": {
            "type": "integer"
          },
          "rateLimit": {
            "type": "object",
            "properties": {
              "maxRps": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "net:request",
          "net:upload",
          "net:stream"
        ]
      }
    }
  },
  "additionalProperties": false
}
