{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UserServerSchema",
  "type": "object",
  "required": [
    "id",
    "login",
    "isAdmin",
    "status",
    "senhaHash",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "login": {
      "type": "string"
    },
    "nome": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "whatsapp": {
      "type": "string"
    },
    "isAdmin": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "disabled"
      ]
    },
    "senhaHash": {
      "type": "string"
    },
    "senhaUpdatedAt": {
      "type": "string"
    },
    "lastLoginAt": {
      "type": "string"
    },
    "lastLoginIp": {
      "type": "string"
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    },
    "ui": {
      "type": "object",
      "properties": {
        "themePreferred": {
          "type": "string",
          "enum": [
            "vscode",
            "light",
            "dark"
          ]
        },
        "moduleOrder": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "iconOrder": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
